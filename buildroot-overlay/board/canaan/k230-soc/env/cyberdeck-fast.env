blinux_fast=k230_set_dtb && ext4load mmc ${mmc_boot_dev_num}:1 0x3000000 /fw_jump_add_uboot_head.bin && ext4load mmc ${mmc_boot_dev_num}:1 0x9000000 /Image.fast.gz 2000001 && itest.l ${filesize} -ge 12 && itest.l ${filesize} -le 2000000 && itest.b *9000000 == 1f && itest.b *9000001 == 8b && itest.b *9000002 == 9 && setexpr fast_end 9000000 + ${filesize} && setexpr fast_isize ${fast_end} - 4 && itest.l *${fast_isize} -gt 0 && itest.l *${fast_isize} -le 2000000 && unzip 0x9000000 0x200000 ${filesize} 2000000 && ext4load mmc ${mmc_boot_dev_num}:1 0x2200000 /${dtb} && bootm 0x3000000 - 0x2200000
