#!/bin/sh
# Selected only by a single-boot init= override.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys || mount -t sysfs sysfs /sys
mountpoint -q /run || mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run

next=/sbin/init
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        blinix.next_init=/usr/local/sbin/cyberdeck-display-init)
            [ ! -x "${arg#*=}" ] || next=${arg#*=} ;;
    esac
done

@ipv4
if [ -s /root/blinix-boot-bench/wifi.conf ] && [ -s /etc/cyberdeck/net-fetch.conf ] &&
@ipv6
if [ -s /root/blinix-boot-bench/wifi.conf ] &&
@both
    [ -x /usr/local/sbin/@PREFIX@-worker ] && [ -x /usr/local/sbin/@PREFIX@-dhcp-hook ] &&
    [ -x /usr/local/sbin/@PREFIX@-fetch ] && mountpoint -q /run; then
    # Stage both runtime overrides before PID 1 runs either NetworkManager or the stock fetch.
    mkdir -p /run/NetworkManager/conf.d /run/systemd/system
    if mkdir -m 0700 /run/@PREFIX@ &&
        printf '[device-@PREFIX@]\nmatch-device=interface-name:wlan0\nmanaged=0\n' > /run/NetworkManager/conf.d/99-@PREFIX@.conf &&
        ln -s /dev/null /run/systemd/system/cyberdeck-net-fetch.service; then
        /usr/local/sbin/@PREFIX@-worker </dev/null >/run/@PREFIX@/worker.log 2>&1 &
    else
        rm -f /run/NetworkManager/conf.d/99-@PREFIX@.conf
    fi
fi
exec "$next" "$@"
